config_version=5
[application]
config/name="TypeTick"
config/description="A mechanical writing studio"
run/main_scene="res://Studio.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
anti_aliasing/quality/msaa_3d=2
environment/ssao/quality=2
environment/defaults/default_clear_color=Color(0.16,0.14,0.115,1)
textures/vram_compression/import_etc2_astc=true
